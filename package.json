{
  "name": "my-develop-harness",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Issues を実行する自律開発 CLI ハーネス",
  "type": "module",
  "bin": {
    "harness": "dist/index.js"
  },
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "build": "bun scripts/build.ts",
    "build:binary": "bun build --compile --target=bun-linux-x64 --minify --define HARNESS_COMPILED=true src/index.ts --outfile build/harness-linux-x64",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.162.1",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "patchedDependencies": {
    "bun-types@1.4.3": "patches/bun-types@1.4.3.patch"
  }
}
